# Quebras de linha normalizadas para LF no repositório
* text=auto

# Arquivos do Visual Studio com CRLF
*.sln    text eol=crlf
*.slnx   text eol=crlf
*.csproj text eol=crlf
*.esproj text eol=crlf
*.props  text eol=crlf

# Arquivos executados em containers Linux sempre com LF
*.sh       text eol=lf
*.sql      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.conf     text eol=lf
Dockerfile text eol=lf

# Binários
*.png binary
*.jpg binary
*.ico binary
